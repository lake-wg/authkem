    {
      "number": 2,
      "id": "I_kwDOTf_4GM8AAAABOTpVgQ",
      "title": "Add optional message_6",
      "url": "https://github.com/lake-wg/authkem/issues/2",
      "state": "OPEN",
      "author": "emanjon",
      "authorAssociation": "NONE",
      "assignees": [],
      "labels": [],
      "body": "This method needs an optional message_6 similar to message_4 in RFC 9528. Some use cases such as EAP-EDHOC need a protected success indication.\n\nG\u00f6ran suggested that maybe LAKE should specify a general construction for for these type of messages only containing a tag and EAD. You could even allow more than one such message.\n\nhttps://mailarchive.ietf.org/arch/msg/lake/qZShy010mEi6EqNGL2WjXCYi-10/\n",
      "createdAt": "2026-08-26T08:45:08Z",
      "updatedAt": "2026-08-26T08:45:08Z",
      "closedAt": null,
      "comments": []
    },
    {
      "number": 3,
      "id": "I_kwDOTf_4GM8AAAABSFBtZQ",
      "title": "Remove Section 6.3 Four-Message Variant",
      "url": "https://github.com/lake-wg/authkem/issues/3",
